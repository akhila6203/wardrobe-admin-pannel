CREATE DATABASE IF NOT EXISTS biryani_db
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE biryani_db;


/* =========================================
   ADMINS
========================================= */

CREATE TABLE IF NOT EXISTS admins (
    id INT NOT NULL AUTO_INCREMENT,

    name VARCHAR(100) NOT NULL,

    username VARCHAR(100) NOT NULL,

    email VARCHAR(150) NOT NULL,

    password_hash VARCHAR(255) NOT NULL,

    created_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    PRIMARY KEY (id),

    UNIQUE KEY unique_admin_username (
        username
    ),

    UNIQUE KEY unique_admin_email (
        email
    )
) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;


/* =========================================
   MENU
========================================= */

CREATE TABLE menu_items (
    id INT NOT NULL AUTO_INCREMENT,

    name VARCHAR(150) NOT NULL,

    portion_type VARCHAR(50) NOT NULL,

    amount DECIMAL(10,2) NOT NULL,

    is_active TINYINT(1)
        NOT NULL
        DEFAULT 1,

    created_at TIMESTAMP
        NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP
        NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    PRIMARY KEY (id),

    KEY idx_menu_active (
        is_active
    )
)
ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;

/* =========================================
   ORDERS
========================================= */

CREATE TABLE IF NOT EXISTS orders (
    id INT NOT NULL AUTO_INCREMENT,

    customer_name VARCHAR(150)
        NOT NULL,

    mobile VARCHAR(20)
        NOT NULL,

    total_amount DECIMAL(10,2)
        NOT NULL,

    payment_method VARCHAR(50)
        DEFAULT NULL,

    payment_status VARCHAR(20)
        NOT NULL
        DEFAULT 'pending',

    razorpay_order_id VARCHAR(150)
        DEFAULT NULL,

    razorpay_payment_id VARCHAR(150)
        DEFAULT NULL,

    created_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    PRIMARY KEY (id),

    KEY idx_payment_status (
        payment_status
    ),

    KEY idx_razorpay_order (
        razorpay_order_id
    ),

    KEY idx_razorpay_payment (
        razorpay_payment_id
    )
) ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;


/* =========================================
   ORDER ITEMS
========================================= */

CREATE TABLE order_items (
    id INT NOT NULL AUTO_INCREMENT,

    order_id INT NOT NULL,

    menu_item_id INT DEFAULT NULL,

    item_name VARCHAR(150) NOT NULL,

    portion_type VARCHAR(50) NOT NULL,

    quantity INT NOT NULL,

    unit_amount DECIMAL(10,2) NOT NULL,

    total_amount DECIMAL(10,2) NOT NULL,

    created_at TIMESTAMP
        NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),

    KEY idx_order_id (
        order_id
    ),

    KEY idx_menu_item_id (
        menu_item_id
    ),

    CONSTRAINT fk_order_items_order
        FOREIGN KEY (order_id)
        REFERENCES orders(id)
        ON DELETE CASCADE
        ON UPDATE CASCADE,

    CONSTRAINT fk_order_items_menu
        FOREIGN KEY (menu_item_id)
        REFERENCES menu_items(id)
        ON DELETE SET NULL
        ON UPDATE CASCADE
)
ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;



USE biryani_db;

CREATE TABLE IF NOT EXISTS carts (
    id INT NOT NULL AUTO_INCREMENT,
    status VARCHAR(30) NOT NULL DEFAULT 'active',
    total_amount DECIMAL(10,2) NOT NULL DEFAULT 0.00,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    PRIMARY KEY (id),
    INDEX idx_cart_status (status)
);


CREATE TABLE IF NOT EXISTS cart_items (
    id INT NOT NULL AUTO_INCREMENT,
    cart_id INT NOT NULL,
    menu_item_id INT NOT NULL,
    item_name VARCHAR(150) NOT NULL,
    portion_type VARCHAR(100) NOT NULL,
    quantity INT NOT NULL,
    unit_amount DECIMAL(10,2) NOT NULL,
    total_amount DECIMAL(10,2) NOT NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PRIMARY KEY (id),

    CONSTRAINT fk_cart_items_cart
        FOREIGN KEY (cart_id)
        REFERENCES carts(id)
        ON DELETE CASCADE,

    CONSTRAINT fk_cart_items_menu
        FOREIGN KEY (menu_item_id)
        REFERENCES menu_items(id)
        ON DELETE CASCADE,

    INDEX idx_cart_item_cart (cart_id),
    INDEX idx_cart_item_menu (menu_item_id)
);


CREATE TABLE `integration_settings` (
    `id` INT NOT NULL AUTO_INCREMENT,

    `provider` VARCHAR(50) NOT NULL,

    `is_enabled` TINYINT(1) NOT NULL DEFAULT 0,

    `public_key` VARCHAR(255) DEFAULT NULL,

    `secret_value` TEXT DEFAULT NULL,

    `email` VARCHAR(255) DEFAULT NULL,

    `password_value` TEXT DEFAULT NULL,

    `pickup_location` VARCHAR(255) DEFAULT NULL,

    `channel_id` VARCHAR(100) DEFAULT NULL,

    `created_at` TIMESTAMP NOT NULL
        DEFAULT CURRENT_TIMESTAMP,

    `updated_at` TIMESTAMP NOT NULL
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP,

    PRIMARY KEY (`id`),

    UNIQUE KEY `uq_integration_provider` (`provider`)
)
ENGINE=InnoDB
DEFAULT CHARSET=utf8mb4
COLLATE=utf8mb4_unicode_ci;


